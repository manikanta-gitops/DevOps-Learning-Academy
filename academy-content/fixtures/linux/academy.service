[Unit]
Description=Personal academy training service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/academy
ExecStart=/usr/bin/python3 /opt/academy/server.py
User=nobody
Group=nogroup
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8080
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target